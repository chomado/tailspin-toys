---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categoryMap = new Map<number, { id: number; name: string }>();
const publisherMap = new Map<number, { id: number; name: string }>();

for (const game of games) {
  if (game.category) {
    categoryMap.set(game.category.id, game.category);
  }

  if (game.publisher) {
    publisherMap.set(game.publisher.id, game.publisher);
  }
}

const categories = Array.from(categoryMap.values()).sort((left, right) => left.name.localeCompare(right.name));
const publishers = Array.from(publisherMap.values()).sort((left, right) => left.name.localeCompare(right.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mt-8 space-y-6">
      <div
        class="rounded-2xl border border-slate-700 bg-slate-800/70 p-6 shadow-lg"
        data-testid="game-filters"
      >
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="space-y-4">
            <fieldset class="space-y-3">
              <legend class="text-sm font-medium uppercase tracking-[0.2em] text-slate-400">
                Categories
              </legend>
              <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                  <label
                    class="flex items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500/50 focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/40"
                  >
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-blue-500 focus:ring-offset-slate-900"
                      data-testid={`category-filter-${category.id}`}
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div class="space-y-2">
              <label
                for="publisher-filter"
                class="text-sm font-medium uppercase tracking-[0.2em] text-slate-400"
              >
                Publisher
              </label>
              <select
                id="publisher-filter"
                name="publisher"
                class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-slate-100 shadow-sm transition-colors focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900 md:w-64"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>
          </div>

          <button
            type="button"
            class="rounded-lg border border-slate-600 bg-slate-900/70 px-4 py-2 text-sm font-medium text-slate-100 transition-colors hover:border-blue-500 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
            data-testid="clear-filters-button"
          >
            Clear filters
          </button>
        </div>

        <p role="status" aria-live="polite" data-testid="filter-results-summary" class="mt-4 text-sm text-slate-400">
          Showing all {games.length} games
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

        {games.length === 0 ? (
          <EmptyState text="No games available at the moment." />
        ) : (
          <>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
              {games.map((game) => <GameCard game={game} />)}
            </div>
            <div data-testid="filtered-empty-state" class="hidden">
              <EmptyState text="No games match the selected filters." />
            </div>
          </>
        )}
      </div>
    </div>
  </div>
</Layout>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const categoryInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="category"]'));
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const clearFiltersButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters-button"]');
  const summary = document.querySelector<HTMLElement>('[data-testid="filter-results-summary"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  const updateVisibleGames = () => {
    const selectedCategories = categoryInputs
      .filter((input) => input.checked)
      .map((input) => input.value);
    const selectedPublisher = publisherFilter?.value ?? '';

    let visibleCount = 0;

    cards.forEach((card) => {
      const categoryId = card.getAttribute('data-category-id');
      const publisherId = card.getAttribute('data-publisher-id');
      const matchesCategory = selectedCategories.length === 0 || selectedCategories.includes(categoryId ?? '');
      const matchesPublisher = selectedPublisher === '' || publisherId === selectedPublisher;
      const isVisible = matchesCategory && matchesPublisher;

      card.style.display = isVisible ? '' : 'none';

      if (isVisible) {
        visibleCount += 1;
      }
    });

    if (gamesGrid) {
      gamesGrid.style.display = visibleCount === 0 ? 'none' : '';
    }

    if (emptyState) {
      emptyState.style.display = visibleCount === 0 ? '' : 'none';
    }

    if (summary) {
      summary.textContent =
        visibleCount === cards.length ? `Showing all ${cards.length} games` : `Showing ${visibleCount} of ${cards.length} games`;
    }
  };

  if (cards.length > 0) {
    categoryInputs.forEach((input) => input.addEventListener('change', updateVisibleGames));
    publisherFilter?.addEventListener('change', updateVisibleGames);
    clearFiltersButton?.addEventListener('click', () => {
      categoryInputs.forEach((input) => {
        input.checked = false;
      });

      if (publisherFilter) {
        publisherFilter.value = '';
      }

      updateVisibleGames();
    });

    updateVisibleGames();
  }
</script>
